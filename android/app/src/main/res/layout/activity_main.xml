<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg">

    <!-- 承载网页的 WebView：内容延伸到状态栏 / 导航栏之下
         （页面背景自带颜色，避让由网页 CSS 的 env(safe-area-inset-*) 完成） -->
    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/page_bg"
        android:overScrollMode="never"
        android:scrollbarStyle="insideInset" />

    <!-- 顶部加载进度条 -->
    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/brand"
        android:visibility="gone" />

    <!-- 启动闪屏：网页首帧就绪后淡出，避免白屏 -->
    <LinearLayout
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/page_bg"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/splash_mark"
            android:contentDescription="@string/app_name"
            android:padding="15dp"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/app_name"
            android:textColor="@color/brand_dark"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/splash_loading"
            android:textColor="@color/text_muted"
            android:textSize="12.5sp" />
    </LinearLayout>
</FrameLayout>